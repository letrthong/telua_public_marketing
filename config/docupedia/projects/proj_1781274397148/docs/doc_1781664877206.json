      },
      {
        "insert": "\n# Tìm file nhanh trong thư mục hiện tại"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "alias findf='find . -name'"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "# Tìm thư mục"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "alias findd='find . -type d -name'"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "# Tìm kiếm nội dung trong file"
