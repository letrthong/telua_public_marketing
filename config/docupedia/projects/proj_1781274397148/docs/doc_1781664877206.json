  "title": "02 Cli",
  "parent_id": "folder_1781664831259",
  "content": {
    "ops": [
      {
        "attributes": {
          "bold": true
        },
        "insert": "1/ Find all files in the current directory."
      },
      {
        "attributes": {
          "header": 5
        },
        "insert": "\n"
      },
      {
        "insert": "find . -name \"xyz*.txt\""
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " \n"
      },
      {
        "attributes": {
          "bold": true
        },
        "insert": "2/ Find the paths of all folders in the current directory"
      },
      {
        "insert": "\n find .  -type d -name \"name_folder\" "
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "attributes": {
          "header": 5
        },
        "insert": "\n"
      },
      {
        "attributes": {
          "bold": true
        },
        "insert": "3/ Find the text within the files in the directory"
      },
      {
        "attributes": {
          "header": 5
        },
        "insert": "\n"
      },
      {
        "insert": "\ngrep -rnw \".\" -e \"setGroupVolume\""
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "grep -rn --include=\"*.java\"\"setGroupVolume\" "
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "rg \"setGroupVolume\""
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "\n "
      },
      {
        "attributes": {
          "bold": true
        },
        "insert": "4/  dùng "
      },
      {
        "attributes": {
          "bold": true,
          "code": true
        },
        "insert": "sed"
      },
      {
        "attributes": {
          "bold": true
        },
        "insert": " để xóa ký tự "
      },
      {
        "attributes": {
          "bold": true,
          "code": true
        },
        "insert": "CR "
      },
      {
        "attributes": {
          "bold": true
        },
        "insert": " khi chuyển file script từ Windows sang Linux"
      },
      {
        "insert": "\nsed -i 's/\\r$//' cli_docker.sh"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "\nMở file cấu hình shell của bạn (thường là "
      },
      {
        "attributes": {
          "code": true
        },
        "insert": "~/.bashrc"
      },
      {
        "insert": " hoặc "
      },
      {
        "attributes": {
          "code": true
        },
        "insert": "~/.zshrc"
      },
      {
        "insert": "): "
      },
      {
        "attributes": {
          "code": true
        },
        "insert": "vi ~/.bashrc"
      },
      {
        "insert": "\n# Tìm file nhanh trong thư mục hiện tại"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "alias find_file='find . -name'"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "# Tìm thư mục"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "alias find_dir='find . -type d -name'"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "# Tìm kiếm nội dung trong file"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "alias find_text='grep -rnw \".\" -e'"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      }
    ]
  },
