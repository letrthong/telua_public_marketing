      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " cart.addObserver(emailNotifier);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " cart.addObserver(rewardSystem);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " // Giao dịch 1: Dùng CARD"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
