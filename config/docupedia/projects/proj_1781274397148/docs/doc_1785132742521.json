      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " cart.setPaymentStrategy(PaymentFactory::getStrategy(\"PAYPAL\"));"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " cart.checkout(200);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " return 0;"
