      },
      {
        "insert": "// --- 2. STRATEGY PATTERN (Thanh toán) ---"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "class PaymentStrategy {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " public:"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " virtual ~PaymentStrategy() = default;"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " // Truyền thêm tên loại thanh toán để Observer dễ nhận biết"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " virtual void pay(int amount) = 0;"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " virtual std::string getMethodName() const = 0;"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "};"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
