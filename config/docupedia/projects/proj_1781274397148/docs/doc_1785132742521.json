      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "};"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "// --- 4. CONTEXT (ShoppingCart kết hợp Subject của Observer) ---"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "class ShoppingCart {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " private:"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " std::unique_ptr<PaymentStrategy> strategy;"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " std::vector<std::shared_ptr<PaymentObserver>>"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "   observers; // Danh sách người quan sát"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " public:"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " void setPaymentStrategy(std::unique_ptr<PaymentStrategy> s) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  strategy = std::move(s);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " // Đăng ký Observer"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " void addObserver(std::shared_ptr<PaymentObserver> observer) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  observers.push_back(observer);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " // Hủy đăng ký Observer (nếu cần)"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " void removeObserver(std::shared_ptr<PaymentObserver> observer) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  observers.erase(std::remove(observers.begin(), observers.end(), observer),"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "          observers.end());"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " // Thông báo cho tất cả Observer"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " void notifyObservers(int amount, const std::string& method) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  for (const auto& observer : observers) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "   observer->onPaymentCompleted(amount, method);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": " void checkout(int amount) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  if (!strategy) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "   std::cout << \"Strategy not set!\\n\";"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "   return;"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "  // 1. Thực hiện thanh toán bằng Strategy"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "  strategy->pay(amount);"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "  // 2. Kích hoạt thông báo tới các Observer sau khi thanh toán thành công"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "  notifyObservers(amount, strategy->getMethodName());"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " }"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "};"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "// --- 5. CHƯƠNG TRÌNH CHÍNH ---"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "int main() {"
      },
      {
        "attributes": {
          "code-block": true
        },
