      {
        "insert": "// --- 3. FACTORY PATTERN ---"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "class PaymentFactory {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " public:"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": " static std::unique_ptr<PaymentStrategy> getStrategy(const std::string& type) {"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "  if (type == \"CARD\") return std::make_unique<CreditCardPayment>();"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "  if (type == \"PAYPAL\") return std::make_unique<PayPalPayment>();"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n\n"
      },
      {
        "insert": "  return nullptr;"
