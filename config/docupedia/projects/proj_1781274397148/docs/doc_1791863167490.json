      {
        "attributes": {
          "color": "#202124"
        },
        "insert": "Start the app"
      },
      {
        "insert": "\n\nadb shell am start com.google.android.car.kitchensink/.KitchenSinkActivity"
      },
      {
        "attributes": {
          "code-block": true
        },
