      },
      {
        "insert": "\n Cấu hình mặc định luôn dùng VS-Code cho Git để amend  và đổi message\ngit config --global core.editor \"code --wait\""
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "git commit --amend -s"
      },
      {
        "attributes": {
          "code-block": true
        },
        "insert": "\n"
      },
      {
        "insert": "\ngit amend\n# Edit and stage the missing file"
